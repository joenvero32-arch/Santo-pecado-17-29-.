<div class="carrito">
<h2>🛒 Mi pedido</h2>
<div id="lista">No has agregado productos.</div>
<h3>Total: $<span id="total">0</span></h3>

<label>Nombre</label>
<input id="nombre" placeholder="Tu nombre">

<label>Teléfono</label>
<input id="telefono" placeholder="Tu teléfono">

<label>Tipo de pedido</label>
<select id="tipo">
<option>Para recoger</option>
<option>Domicilio</option>
<option>Comer en el restaurante</option>
</select>

<label>Dirección</label>
<input id="direccion" placeholder="Dirección">

<label>Notas</label>
<textarea id="notas" placeholder="Observaciones del pedido"></textarea>

<button class="whatsapp" onclick="enviarWhatsApp()">
📲 ENVIAR PEDIDO POR WHATSAPP
</button>
</div>

</main>

<script>
let pedido=[];
let total=0;

function agregar(nombre,precio){
pedido.push({nombre,precio});
total+=precio;
mostrar();
}

function mostrar(){
let lista=document.getElementById("lista");

if(pedido.length===0){
lista.innerHTML="No has agregado productos.";
}else{
lista.innerHTML=pedido.map((p,i)=>
`${i+1}. ${p.nombre} - $${p.precio.toLocaleString("es-CO")}`
).join("<br>");
}

document.getElementById("total").textContent=
total.toLocaleString("es-CO");
}

function enviarWhatsApp(){

if(pedido.length===0){
alert("Agrega al menos un producto.");
return;
}

let nombre=document.getElementById("nombre").value;
let telefono=document.getElementById("telefono").value;
let tipo=document.getElementById("tipo").value;
let direccion=document.getElementById("direccion").value;
let notas=document.getElementById("notas").value;

if(!nombre){
alert("Escribe tu nombre.");
return;
}

let mensaje=
"🍔 *SANTO PECADO 17-29*%0A%0A"+
"*PEDIDO*%0A"+
pedido.map((p,i)=>
(i+1)+". "+p.nombre+" - $"+
p.precio.toLocaleString("es-CO")
).join("%0A")+
"%0A%0A*TOTAL: $"+
total.toLocaleString("es-CO")+"*"+
"%0A%0A*Cliente:* "+nombre+
"%0A*Teléfono:* "+telefono+
"%0A*Tipo:* "+tipo+
"%0A*Dirección:* "+direccion+
"%0A*Notas:* "+notas;

let numero="573116637215";

window.open(
"https://wa.me/"+numero+"?text="+mensaje,
"_blank"
);
}
</script>

